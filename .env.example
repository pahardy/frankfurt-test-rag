# Copy this file to .env and fill in your credentials.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: path to corporate SSL certificate bundle.
# Export your system keychain to a .pem file and set this if you're behind
# a corporate proxy that intercepts HTTPS.
# SSL_CERT_FILE=/path/to/system-certs.pem
